{
  "manifest_version": 3,
  "name": "Versioned Asset Inspector",
  "version": "1.0.0",
  "description": "Zeigt alle Ressourcen einer Domain und listet versionierte Assets (z. B. /paket/1.2.0/bundle.js) mit ihren Versionen.",
  "permissions": ["webRequest", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Versioned Asset Inspector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
